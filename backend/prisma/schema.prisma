// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Device {
  id                    String    @id @default(uuid()) @db.Uuid
  deviceFingerprintHash String    @unique @map("device_fingerprint_hash")
  publicKey             String    @map("public_key")
  phoneHash             String?   @map("phone_hash")
  createdAt             DateTime  @default(now()) @map("created_at")
  lastSeenAt            DateTime? @map("last_seen_at")

  episodes              Episode[]
  capsules              Capsule[]

  @@map("devices")
}

model Episode {
  id                String    @id @default(uuid()) @db.Uuid
  requesterDeviceId String    @map("requester_device_id") @db.Uuid
  category          String
  urgency           Int       @db.SmallInt
  status            String    @default("pending") // pending/matched/active/completed/expired/cancelled
  latitude          Float
  longitude         Float
  radiusMeters      Int       @default(500) @map("radius_meters")
  location          Unsupported("geography(Point, 4326)")?
  bchSyndromes      String?   @map("bch_syndromes")
  helperStringY     String?   @map("helper_string_y")
  gridCellsJson     String?   @map("grid_cells_json")
  createdAt         DateTime  @default(now()) @map("created_at")
  expiresAt         DateTime  @map("expires_at")

  requester         Device    @relation(fields: [requesterDeviceId], references: [id])
  capsules          Capsule[]
  outcomes          Outcome[]
  auditLogs         AuditLog[]

  @@map("episodes")
}

model Capsule {
  id              String    @id @default(uuid()) @db.Uuid
  episodeId       String    @map("episode_id") @db.Uuid
  helperDeviceId  String    @map("helper_device_id") @db.Uuid
  signedTokenHash String    @map("signed_token_hash")
  status          String    @default("issued") // issued/redeemed/expired/revoked
  blindedGridCell String?   @map("blinded_grid_cell")
  issuedAt        DateTime  @default(now()) @map("issued_at")
  expiresAt       DateTime  @map("expires_at")
  redeemedAt      DateTime? @map("redeemed_at")

  episode         Episode   @relation(fields: [episodeId], references: [id])
  helper          Device    @relation(fields: [helperDeviceId], references: [id])

  @@map("capsules")
}

model Outcome {
  id                String   @id @default(uuid()) @db.Uuid
  episodeId         String   @map("episode_id") @db.Uuid
  result            String   // success/failure
  category          String
  riskLevel         Int?     @map("risk_level") @db.SmallInt
  completedInWindow Boolean  @map("completed_in_window")
  createdAt         DateTime @default(now()) @map("created_at")

  episode           Episode  @relation(fields: [episodeId], references: [id])

  @@map("outcomes")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  eventType String   @map("event_type")
  episodeId String?  @map("episode_id") @db.Uuid
  prevHash  String   @map("prev_hash")
  entryHash String   @map("entry_hash")
  createdAt DateTime @default(now()) @map("created_at")

  episode   Episode? @relation(fields: [episodeId], references: [id])

  @@map("audit_log")
}
