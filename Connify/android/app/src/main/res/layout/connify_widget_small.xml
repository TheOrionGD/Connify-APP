<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/connify_widget_bg"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/widget_small_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡 CONNIFY"
        android:textColor="#F87171"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_small_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Ready"
        android:textColor="#9CA3AF"
        android:textSize="10sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/btn_small_sos"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/connify_btn_red"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="SEND SOS"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
