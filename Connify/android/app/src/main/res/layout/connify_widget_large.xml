<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/connify_widget_bg"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/widget_large_header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡 CONNIFY SAFETY"
        android:textColor="#F87171"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_large_status"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="● Protection Ready"
        android:textColor="#10B981"
        android:textSize="12sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="8dp" />

    <TextView
        android:id="@+id/btn_large_sos"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/connify_btn_red"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="SEND SOS"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_large_help"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:layout_marginBottom="6dp"
        android:background="@drawable/connify_btn_dark"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="REQUEST NEARBY HELP"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/btn_large_open"
        android:layout_width="match_parent"
        android:layout_height="38dp"
        android:background="@drawable/connify_btn_dark"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center"
        android:text="OPEN CONNIFY"
        android:textColor="#FFFFFF"
        android:textSize="11sp"
        android:textStyle="bold" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/widget_large_footer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nearby helpers: 4"
        android:textColor="#9CA3AF"
        android:textSize="11sp" />

</LinearLayout>
